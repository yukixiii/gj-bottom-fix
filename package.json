{
  "name": "gj-bottom-fix",
  "version": "0.1.0",
  "description": "In Vim mode, gj/gk at the last/first line keeps the cursor in place instead of jumping to the top of the note.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "vim", "gj"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  }
}
